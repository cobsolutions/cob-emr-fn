{
    "controls": [
      {
        "name": "hasAdditionalInfo",
        "label": "hasAdditionalInfo",
        "type": "radio"
      },
      {
        "name": "additionalInfo",
        "label": "Additional Information",
        "type": "text",
        "showIf": { "control": "hasAdditionalInfo", "value": "Yes" }
      },
      {
        "name": "email",
        "label": "Email",
        "type": "email",
        "validators": { "required": true, "email": true }
      },
      {
        "name": "age",
        "label": "Age",
        "type": "number",
        "validators": { "required": true, "min": 18, "max": 65 }
      }
    ]
  }
  